<?xml version="1.0" encoding="utf-8"?>
<!-- Botón central de play/pausa del Widget Classic. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#B9D6F2"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#6FA6DA" />
        </shape>
    </item>
    <item
        android:height="16dp"
        android:gravity="top"
        android:left="4dp"
        android:right="4dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
