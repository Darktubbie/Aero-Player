<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#8FB7DE"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#5A8CC2" />
        </shape>
    </item>
    <item
        android:height="16dp"
        android:gravity="top"
        android:left="6dp"
        android:right="6dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
