<?xml version="1.0" encoding="utf-8"?>
<!-- Orbe de play (light): anillo verde de acento + cuerpo de vidrio + reflejo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#7FE0AC"
                android:startColor="#F2FFF7" />
            <stroke
                android:width="2.5dp"
                android:color="#2FBF6F" />
        </shape>
    </item>
    <item
        android:height="15dp"
        android:gravity="top"
        android:left="5dp"
        android:right="5dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
