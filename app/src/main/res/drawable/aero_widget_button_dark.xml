<?xml version="1.0" encoding="utf-8"?>
<!-- Botón circular de vidrio (dark): cuerpo degradado + reflejo especular arriba -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#152229"
                android:startColor="#40535F" />
            <stroke
                android:width="1dp"
                android:color="#993EDBC0" />
        </shape>
    </item>
    <item
        android:height="13dp"
        android:gravity="top"
        android:left="4dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
