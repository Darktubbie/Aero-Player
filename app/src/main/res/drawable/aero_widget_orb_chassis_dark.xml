<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#40000000" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:centerX="0.42"
                android:centerY="0.36"
                android:endColor="#082A2C"
                android:startColor="#2E6B6E" />
            <stroke
                android:width="2dp"
                android:color="#3EDBC0" />
        </shape>
    </item>
    <item
        android:height="38dp"
        android:gravity="top"
        android:left="10dp"
        android:right="10dp"
        android:top="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
