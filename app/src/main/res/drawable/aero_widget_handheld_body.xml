<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 03 "Handheld": carcasa de dispositivo portátil helado,
     blanco/celeste glossy, esquinas grandes parejas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#332B4A6E" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#AFCBEA"
                android:startColor="#FDFEFF" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:height="40dp"
        android:gravity="top"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#B3FFFFFF" />
            <corners
                android:bottomLeftRadius="40dp"
                android:bottomRightRadius="40dp"
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
