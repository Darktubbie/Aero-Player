<?xml version="1.0" encoding="utf-8"?>
<!-- Nub decorativo (Fase 6, revisión "look único"): un detalle
     físico chico -como un LED/tornillo de dispositivo real- para
     que la silueta no se lea como "una tarjeta con esquinas
     redondeadas". Sin función, solo estética. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2FBF6F" />
            <stroke
                android:width="1dp"
                android:color="#1F8C50" />
        </shape>
    </item>
    <item
        android:height="5dp"
        android:width="5dp"
        android:gravity="top|start"
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
