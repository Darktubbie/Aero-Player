<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de vidrio hundida (claro): azul profundo con brillo en la mitad superior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0A3A8E"
                android:startColor="#2C82E0" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#06285F" />
        </shape>
    </item>
    <item
        android:height="22dp"
        android:gravity="top"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
