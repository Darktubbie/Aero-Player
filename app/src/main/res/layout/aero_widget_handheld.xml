<?xml version="1.0" encoding="utf-8"?>
<!-- Handheld: dispositivo portátil inspirado directamente en widget_03.jpeg. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aero_widget_handheld_scene"
    android:padding="7dp">

    <!-- Revisión "doble capa": el PNG del chasis NO tiene un hueco
         blanco opaco para la pantalla — tiene un hueco TRANSPARENTE
         con forma octogonal (esquinas cortadas), medido con
         flood-fill en 170-905px de 1100 (horizontal) y 125-405px de
         620 (vertical). Antes `widget_art` era un rectángulo
         `match_parent` CON SU PROPIO fondo de pantalla, que tapaba
         ese hueco en vez de asomar a través de él — y como además
         las 3 filas de contenido usaban proporciones arbitrarias (no
         las de la imagen real), con el placeholder verde (un estilo
         totalmente distinto al chasis) el desajuste se leía como
         "dos reproductores superpuestos". Ahora las 3 filas usan
         `layout_weight` sobre las fracciones reales de la imagen
         (20.2% / 45.1% / 34.7% de la altura) para que, sea cual sea
         el tamaño final del widget, el contenido se estire
         exactamente igual que el propio PNG de fondo — y `widget_art`
         ya no tiene fondo propio, solo el inset (en vez de depender
         de layout_weight para el ancho, que no varía por fila) que
         lo deja asomando dentro del hueco en vez de tapar el chasis. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/aero_widget_handheld_shell">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="1000">

            <!-- Bisel superior del chasis (20.2%): sin contenido. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="202" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="451">

                <ImageView
                    android:id="@+id/widget_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="46dp"
                    android:layout_marginEnd="53dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/aero_widget_art_placeholder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="46dp"
                    android:layout_marginEnd="53dp"
                    android:background="@drawable/aero_widget_handheld_caption"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="Song title"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="Artist"
                        android:textColor="#C5EEFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Cuerpo inferior del chasis (34.7%): acá viven los
                 controles reales — es la misma zona donde el PNG ya
                 trae su propio botón de play decorativo, así que
                 queda integrado en vez de flotando aparte. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="347"
                android:gravity="center_vertical"
                android:paddingStart="46dp"
                android:paddingEnd="40dp">

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/aero_widget_handheld_minibutton"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_previous"
                    android:tint="#2E679B" />

                <ImageButton
                    android:id="@+id/widget_play"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/aero_widget_handheld_playknob"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_play"
                    android:tint="#2E679B" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/aero_widget_handheld_minibutton"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_next"
                    android:tint="#2E679B" />

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="1000"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:progress="350"
                    android:progressDrawable="@drawable/aero_widget_progress" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_volume" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
